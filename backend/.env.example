# Copy to .env and export, or set in your host / Docker. Every value has a safe default for local dev.
NODE_ENV=development
PORT=4000
DB_PATH=./stayora.db
CORS_ORIGIN=http://localhost:5173        # comma separated list of allowed browser origins
LOG_LEVEL=info                           # fatal | error | warn | info | debug | trace | silent
TIMEZONE=Asia/Kolkata                    # the property's timezone; decides what "today" is
ADMIN_TOKEN=                             # >= 16 chars. REQUIRED in production; guards /api/bookings and /admin
TRUST_PROXY=0                            # reverse-proxy hops in front of the app (so rate limits see real client IPs)
RATE_LIMIT_PER_MIN=120
BOOKING_RATE_LIMIT_PER_MIN=20
AUTO_SEED=true
